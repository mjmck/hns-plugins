<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
{
	// One event per join sound. The name is what join-sounds.cfg refers to.
	// csgo_mega = 2D, not positional, so every player hears it the same wherever they are (like CS2KZ's kz.* sounds).
	"hns.join.vip" =
	{
		type = "csgo_mega"
		volume = 1.0
		pitch = 1.0
		vsnd_files_track_01 = "sounds/hns/join/vip.vsnd"
	}
	// Played to everyone when a jumpstat server record (#1 in a JumpTop) is broken. Name used in jumpstats.cfg.
	"hns.record" =
	{
		type = "csgo_mega"
		volume = 1.0
		pitch = 1.0
		vsnd_files_track_01 = "sounds/hns/record/server_record.vsnd"
	}
}
